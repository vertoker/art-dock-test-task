.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 27, 32);
    color: rgb(228, 231, 236);
}

.session-panel {
    width: 420px;
    padding: 24px;
    background-color: rgb(39, 43, 51);
    border-radius: 8px;
}

.heading {
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.session-panel .unity-base-field {
    margin-bottom: 12px;
}

.session-panel .unity-base-field__label {
    min-width: 114px;
}

.session-panel Button {
    height: 34px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.status {
    margin-top: 12px;
    white-space: normal;
}
